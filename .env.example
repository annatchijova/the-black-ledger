HOST=127.0.0.1
PORT=4173
LEDGER_DATA_DIR=./data
APP_BASE_URL=http://127.0.0.1:4173

# Optional PayPal Sandbox checkout. PAYPAL_PAYEE_MEMBER_ID must be the ledger member represented by the merchant account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_PAYEE_MEMBER_ID=

# Optional receipt proposals. The model call returns proposals for human review only.
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=gpt-4.1-mini
# Override the provider origin to exercise the analysis path against a local double.
OPENAI_BASE_URL=
